{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalog",
  "type": "object",
  "required": [
    "generatedAt",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "rules": {
      "type": "object",
      "additionalProperties": {
        "title": "CatalogRule",
        "type": "object",
        "required": [
          "description",
          "requires",
          "path",
          "profiles",
          "preference"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preference": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
